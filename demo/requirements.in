torch @ https://download.pytorch.org/whl/cpu/torch-2.13.0%2Bcpu-cp312-cp312-win_amd64.whl ; sys_platform == "win32" and platform_machine == "AMD64"
torch @ https://download.pytorch.org/whl/cpu/torch-2.13.0%2Bcpu-cp312-cp312-win_arm64.whl ; sys_platform == "win32" and platform_machine == "ARM64"
